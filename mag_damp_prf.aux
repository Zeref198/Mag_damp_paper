\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The amplitude decay profile of wave mode $(1,0)$ in a square wave tank with stainless steel sidewall inserts, a) without the presence of a vertical magnetic field $B_z$ and horizontal current $I_y$ and b) in the presence of a magnetic field $B_z=\SI {20}{\milli \tesla }$ ($\rm  Ha = 196$) without horizontal current. At low $\rm  Ha$, we can ignore the effects of the Hartmann layer and consider the damping contribution at the boundary to be purely hydrodynamic. The difference between the total damping and the boundary layer contributions yields the damping rate due to Ohmic dissipation $\lambda _{\text  {o}}=\SI {0.018}{\per \second }$.}}{19}{figure.85}\protected@file@percent }
\newlabel{fig:post_process}{{10}{19}{The amplitude decay profile of wave mode $(1,0)$ in a square wave tank with stainless steel sidewall inserts, a) without the presence of a vertical magnetic field $B_z$ and horizontal current $I_y$ and b) in the presence of a magnetic field $B_z=\SI {20}{\milli \tesla }$ ($\rm Ha = 196$) without horizontal current. At low $\rm Ha$, we can ignore the effects of the Hartmann layer and consider the damping contribution at the boundary to be purely hydrodynamic. The difference between the total damping and the boundary layer contributions yields the damping rate due to Ohmic dissipation $\lambda _{\ii o}=\SI {0.018}{\per \second }$}{figure.85}{}}
\newlabel{fig:post_process@cref}{{[figure][10][]10}{[1][18][]19}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces The comparison of theoretical and experimental damping times $T_{\rm  o} = \lambda _{\text  {o}}^{-1}$ in a wave tank with a) copper sidewalls (B.C 1), and b) stainless steel sidewalls (B.C 4) at different $\rm  Ha$. For the theoretical calculation, copper walls are treated as perfect conductors and stainless steel walls as perfect insulators.}}{19}{figure.86}\protected@file@percent }
\newlabel{fig:exp_results}{{11}{19}{The comparison of theoretical and experimental damping times $T_{\rm o} = \lambda _{\ii o}^{-1}$ in a wave tank with a) copper sidewalls (B.C 1), and b) stainless steel sidewalls (B.C 4) at different $\rm Ha$. For the theoretical calculation, copper walls are treated as perfect conductors and stainless steel walls as perfect insulators}{figure.86}{}}
